generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

enum BusinessRole {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  phone               String?              @unique
  businesses          Business[]
  memberships         BusinessMembership[]
  createdTransactions Transaction[]        @relation("TransactionCreator")
  deletedTransactions Transaction[]        @relation("TransactionDeleter")
  recurringRules      RecurringRule[]      @relation("RecurringRuleCreator")
  createdAt           DateTime             @default(now())
}

model Business {
  id             String               @id @default(cuid())
  name           String
  type           String               @db.VarChar(64)
  address        String?
  ownerId        String
  owner          User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  invoices       Invoice[]
  budgets        Budget[]
  memberships    BusinessMembership[]
  createdAt      DateTime             @default(now())

  @@index([ownerId])
}

model Transaction {
  id              String                  @id @default(cuid())
  businessId      String
  business        Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type            TransactionType
  category        String
  amount          Decimal                 @db.Decimal(12, 2)
  description     String?
  date            DateTime                @default(now())
  recurringRuleId String?
  recurringDate   DateTime?
  recurringRule   RecurringRule?          @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  invoiceId       String?                 @unique
  invoice         Invoice?                @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?                   @relation("TransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deletedById     String?
  deletedBy       User?                   @relation("TransactionDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  attachments     TransactionAttachment[]
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())

  @@unique([recurringRuleId, recurringDate])
  @@index([businessId, date])
  @@index([businessId, createdById, date])
}

model TransactionAttachment {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  storageKey    String      @unique
  fileName      String      @db.VarChar(255)
  mimeType      String      @db.VarChar(100)
  size          Int
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

model RecurringRule {
  id           String              @id @default(cuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type         TransactionType
  category     String
  amount       Decimal             @db.Decimal(12, 2)
  description  String?
  frequency    RecurrenceFrequency
  nextRunAt    DateTime
  dayOfMonth   Int?
  active       Boolean             @default(true)
  createdById  String?
  createdBy    User?               @relation("RecurringRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  transactions Transaction[]
  createdAt    DateTime            @default(now())

  @@index([businessId, active, nextRunAt])
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerName    String        @db.VarChar(150)
  customerEmail   String?       @db.VarChar(254)
  description     String        @db.VarChar(500)
  amount          Decimal       @db.Decimal(12, 2)
  dueDate         DateTime?
  status          InvoiceStatus @default(DRAFT)
  paidTransaction Transaction?
  createdAt       DateTime      @default(now())

  @@index([businessId, createdAt])
}

model Budget {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   String   @db.VarChar(100)
  month      String   @db.VarChar(7)
  limit      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@unique([businessId, category, month])
  @@index([businessId, month])
}

model BusinessMembership {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessRole @default(VIEWER)
  createdAt  DateTime     @default(now())

  @@unique([businessId, userId])
  @@index([userId])
}
